  "isatvon_definition": {
    "i_instructions": "Triggered by Skill 1 completion hook[cite: 7]. Action: Extract critical mechanical attributes (dimensions, PCB layer count, surface finish, tight tolerances, enclosure specs) from drawings and title blocks against Master Capture Checklist[cite: 7]. Handle unreadable drawing edge cases by populating an explicit Gaps List[cite: 7]. Check: Verify all mandatory checklist attributes are parsed or explicitly flagged as gaps.",
    "s_source": {
      "required_inputs": [
        "normalized_drawing_files",
        "master_capture_checklist",
        "pcb_spec_master",
        "mech_and_em_spec_sheet"
      ],
      "fresh_state_parameters": ["extracted_attribute_set", "feature_gaps_register"]
    },
    "a_automation": {
      "orchestration_layer": "Temporal Workflow (SRI Runtime)",
      "action_step": "Run vision/geometry extraction scripts over mechanical PDFs and Gerber files to extract assembly parameters[cite: 7].",
      "acceptance_check": "Programmatically verify: mandatory_checklist_coverage >= 95% OR gap_justification_logged == True[cite: 6, 7]."
    },
    "t_tech_stack": {
      "execution_layer": "FastMCP Engine",
      "action_tool": "Drawing_Feature_Extractor_MCP",
      "fixed_check_tool": "Checklist_Coverage_Validator",
      "gateway": "Bifrost Gateway",
      "telemetry_observer": "PostHog Telemetry"
    },
    "v_variables": {
      "max_iterations": 2,
      "success_gate": "feature_extraction_complete == True",
      "no_op_condition": "no_drawings_in_rfq_package == True",
      "escalation_condition": "drawing_resolution_unreadable OR missing_title_block",
      "budget_limit": "45000ms"
    },
    "o_outcome": {
      "json_schema": "MechanicalAttributeSetPayload",
      "state_handoff_file": "Append to PostgreSQL 'rfq_feature_extraction_audit_log'[cite: 6, 7]."
    },
    "n_next": {
      "ui_updates": ["Status: Parsing Mechanical Attributes -> Capture Checklist Mapped"],
      "database_updates": ["Insert into assembly_attributes and feature_gaps_table"],
      "alerts": ["PostHog telemetry tracks missing attribute count; notify reviewer"],
      "next_step": "On human Action button press, fire completion hook to Skill 3 (Feasibility & Risk)[cite: 7]."
    }
  },
