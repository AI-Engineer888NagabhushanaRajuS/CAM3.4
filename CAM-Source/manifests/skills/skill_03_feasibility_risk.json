  "isatvon_definition": {
    "i_instructions": "Triggered by Skill 2 hook[cite: 7]. Action: Evaluate design complexity against EMS internal machine capability constraints (reflow oven zones, minimum component pitch) and flag high-risk items (Long Lead Time parts, End-of-Life EOL components, tight mechanical tolerances) in one single pass[cite: 7]. Check: Ensure every BOM line receives a definitive 'Can-Build' or 'Cannot-Build' verdict with documented risk reasons[cite: 6, 7].",
    "s_source": {
      "required_inputs": [
        "extracted_attribute_set",
        "scrub_bom_table",
        "ems_internal_capability_and_constraint_template",
        "lead_time_consolidated_table",
        "part_num_vs_mfg_num_master"
      ],
      "fresh_state_parameters": [
        "feasibility_verdict_matrix",
        "risk_register_table"
      ]
    },
    "a_automation": {
      "orchestration_layer": "Temporal Workflow (SRI Runtime)",
      "action_step": "Execute rule engine comparing assembly specs against EMS plant constraints and cross-reference lead-time/EOL databases[cite: 7].",
      "acceptance_check": "Programmatically verify: all_bom_lines_evaluated == True AND risk_flags_registered == True[cite: 6, 7]."
    },
    "t_tech_stack": {
      "execution_layer": "FastMCP Engine",
      "action_tool": "EMS_Feasibility_Risk_Evaluator_MCP",
      "fixed_check_tool": "Constraint_Satisfaction_Checker",
      "gateway": "Bifrost Gateway",
      "telemetry_observer": "PostHog Audit Logger"
    },
    "v_variables": {
      "max_iterations": 2,
      "success_gate": "feasibility_verdict_complete == True",
      "no_op_condition": "bom_is_empty == True",
      "escalation_condition": "unresolvable_machine_constraint_violation",
      "budget_limit": "30000ms"
    },
    "o_outcome": {
      "json_schema": "FeasibilityAndRiskPayload",
      "state_handoff_file": "Append to PostgreSQL 'rfq_feasibility_risk_audit_log'[cite: 6, 7]."
    },
    "n_next": {
      "ui_updates": [
        "Status: Evaluating Machine Rules -> Feasibility Verdict & Risk Flags Generated"
      ],
      "database_updates": [
        "Insert into rfq_feasibility_verdicts and risk_register"
      ],
      "alerts": [
        "PostHog logs high-risk flag occurrences; alert senior engineer"
      ],
      "next_step": "On human Action button press, fire completion hook to Skill 4 (Distributor & Source Selection)[cite: 7]."
    }
  },
