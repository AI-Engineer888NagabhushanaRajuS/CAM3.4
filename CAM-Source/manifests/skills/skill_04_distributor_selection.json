  "isatvon_definition": {
    "i_instructions": "Triggered by Skill 3 hook[cite: 7]. Action: Query preferred distributor catalogs and Commodity Mapping Master tables to assign optimal vendors for specialized electronic components, PCB specs, and custom enclosures[cite: 7]. Check: Verify 100% of BOM parts have at least one vetted vendor mapped with supplier reliability score[cite: 6, 7].",
    "s_source": {
      "required_inputs": [
        "scrub_bom_table",
        "commodity_mapping_master_xlsx",
        "supplier_master_table",
        "new_suppliers_sheet"
      ],
      "fresh_state_parameters": ["assigned_supplier_matrix", "unmapped_part_queue"]
    },
    "a_automation": {
      "orchestration_layer": "Temporal Workflow (SRI Runtime)",
      "action_step": "Scan internal supplier database and API channels to select primary and secondary vendors per part[cite: 7].",
      "acceptance_check": "Programmatically verify: unmapped_parts_count == 0[cite: 6, 7]."
    },
    "t_tech_stack": {
      "execution_layer": "FastMCP Engine",
      "action_tool": "Sourcing_Distributor_Selector_MCP",
      "fixed_check_tool": "Supplier_Mapping_Integrity_Checker",
      "gateway": "Bifrost Gateway",
      "telemetry_observer": "PostHog Audit Logger"
    },
    "v_variables": {
      "max_iterations": 3,
      "success_gate": "all_parts_assigned_suppliers == True",
      "no_op_condition": "sourcing_already_locked == True",
      "escalation_condition": "no_supplier_found_for_critical_part",
      "budget_limit": "30000ms"
    },
    "o_outcome": {
      "json_schema": "SupplierSelectionPayload",
      "state_handoff_file": "Append to PostgreSQL 'rfq_supplier_selection_audit_log'[cite: 6, 7]."
    },
    "n_next": {
      "ui_updates": ["Status: Querying Distributor Catalogs -> Vendors Mapped"],
      "database_updates": ["Insert into rfq_part_supplier_mappings"],
      "alerts": ["PostHog telemetry tracks sole-source vendor warnings; alert sourcing manager[cite: 1, 7]"],
      "next_step": "On human Action button press, fire completion hook to Skill 5 (Supplier RFQ/Quoting Tools)[cite: 7]."
    }
  },
