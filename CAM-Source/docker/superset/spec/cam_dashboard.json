    {"page": 3, "row": 2, "width": 6, "name": "Final buy build-up by payment term", "dataset": "cam_cashflow", "viz": "waterfall", "params": {"x_axis": "supplier_type", "groupby": [], "metric": "final_buy_value", "show_value": true, "y_axis_format": ",.0f"}},
