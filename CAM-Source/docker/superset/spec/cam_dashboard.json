{
  "_about": "SPEC-026 seed for the CAM 3.4 editable BI dashboard. provision.py turns this into Superset datasets, saved metrics, charts, one dashboard with six pages (tabs), native filters and cross-filters. It only SEEDS: once created, every object belongs to the users and is edited in Superset (provision.py --reset re-applies this file). {name} in a dataset's sql is read_parquet over database/analytics/*/name.parquet. Every dataset must expose rfq_id (the guest token's row-level security filters on it).",
  "database": "CAM reports",
  "dashboard": {"slug": "cam-reports", "title": "CAM 3.4 Reports & Analytics"},
  "pages": ["Executive overview & GO/NO-GO", "Cost & price control", "Lead time, feasibility & risk", "Cash flow", "Exceptions & data quality", "All-RFQs explorer"],
  "filters": [
    {"name": "RFQ", "dataset": "cam_rfq_overview", "column": "rfq_id", "multi": true},
    {"name": "Volume", "dataset": "cam_kpi_volume", "column": "volume_no", "multi": false, "first_item": true},
    {"name": "Assembly (FG)", "dataset": "cam_cbom", "column": "fg", "multi": true},
    {"name": "Commodity", "dataset": "cam_cbom", "column": "commodity", "multi": true},
    {"name": "Supplier", "dataset": "cam_cbom", "column": "supplier", "multi": true}
  ],
  "datasets": {
    "cam_rfq_overview": {
      "sql": "SELECT rfq_id, max(text) FILTER (WHERE metric = 'go') AS go_no_go, max(value) FILTER (WHERE metric = 'priced_ratio') AS priced_ratio, max(value) FILTER (WHERE metric = 'cbom_lines') AS cbom_lines, max(value) FILTER (WHERE metric = 'uncosted_parts') AS uncosted_parts, max(value) FILTER (WHERE metric = 'error_cells') AS error_cells, arg_min(value, volume_no) FILTER (WHERE metric = 'cost_per_set') AS cost_per_set_first_volume, arg_min(value, volume_no) FILTER (WHERE metric = 'final_buy_value') AS final_buy_first_volume, max(text) FILTER (WHERE metric = 'workbook') AS workbook FROM {kpi} GROUP BY rfq_id",
      "metrics": {"rfqs": ["COUNT(DISTINCT rfq_id)", "RFQs", ",d"], "go_rfqs": ["COUNT(*) FILTER (WHERE go_no_go = 'GO')", "RFQs with GO", ",d"], "avg_priced_ratio": ["AVG(priced_ratio)", "Priced share (average)", ".1%"], "cost_first_volume": ["SUM(cost_per_set_first_volume)", "Cost per set, first volume", ",.2f"], "lines": ["SUM(cbom_lines)", "CBOM lines", ",d"]}
    },
    "cam_kpi_rfq": {
      "sql": "SELECT rfq_id, metric, value, text FROM {kpi} WHERE volume_no IS NULL",
      "metrics": {"value_sum": ["SUM(value)", "Value", ",.2f"], "cbom_lines": ["SUM(value) FILTER (WHERE metric = 'cbom_lines')", "CBOM lines", ",d"], "priced_ratio": ["SUM(value) FILTER (WHERE metric = 'priced_lines') / NULLIF(SUM(value) FILTER (WHERE metric = 'cbom_lines'), 0)", "Priced share", ".1%"], "uncosted_parts": ["SUM(value) FILTER (WHERE metric = 'uncosted_parts')", "Uncosted parts", ",d"], "error_cells": ["SUM(value) FILTER (WHERE metric = 'error_cells')", "Error cells", ",d"]}
    },
    "cam_kpi_volume": {
      "sql": "SELECT rfq_id, metric, volume_no, value FROM {kpi} WHERE volume_no IS NOT NULL",
      "metrics": {"value_sum": ["SUM(value)", "Value", ",.2f"], "cost_per_set": ["SUM(value) FILTER (WHERE metric = 'cost_per_set')", "Cost per set", ",.2f"], "ext_vol_cost": ["SUM(value) FILTER (WHERE metric = 'ext_vol_cost')", "Extended volume cost", ",.0f"], "moq_cost": ["SUM(value) FILTER (WHERE metric = 'moq_cost')", "MOQ cost", ",.0f"], "excess_cost": ["SUM(value) FILTER (WHERE metric = 'excess_cost')", "Excess cost", ",.0f"], "final_buy_value": ["SUM(value) FILTER (WHERE metric = 'final_buy_value')", "Final buy value", ",.0f"], "buy_value": ["SUM(value) FILTER (WHERE metric = 'buy_value')", "Buy value", ",.0f"]}
    },
    "cam_cost_by_fg": {"sql": "SELECT rfq_id, assembly AS fg, volume_no, cost_per_set FROM {wb_summary}", "metrics": {"cost_per_set": ["SUM(cost_per_set)", "Cost per set", ",.2f"]}},
    "cam_price_control": {"sql": "SELECT * FROM {wb_price_control}", "metrics": {"ext_vol_cost": ["SUM(ext_vol_cost)", "Extended volume cost", ",.0f"], "ext_price": ["SUM(ext_price)", "Extended price", ",.2f"]}},
    "cam_lead_time": {"sql": "SELECT * FROM {wb_lead_time}", "metrics": {"parts": ["SUM(parts)", "Parts", ",d"]}},
    "cam_cashflow": {"sql": "SELECT * FROM {wb_cashflow}", "metrics": {"final_buy_value": ["SUM(final_buy_value)", "Final buy value", ",.0f"], "buy_value": ["SUM(buy_value)", "Buy value", ",.0f"]}},
    "cam_excess": {"sql": "SELECT * FROM {wb_commodity_excess}", "metrics": {"net_excess_cost": ["SUM(net_excess_cost)", "Net excess cost", ",.0f"]}},
    "cam_cbom": {
      "sql": "SELECT *, COALESCE(final_supp_name, supp_name_qw, supp_name_erp, supp_name_costing) AS supplier FROM {cbom}",
      "dttm": ["exp_date"],
      "metrics": {"lines": ["COUNT(*)", "Lines", ",d"], "priced_lines": ["COUNT(*) FILTER (WHERE final_price_conv <> 0)", "Priced lines", ",d"], "priced_ratio": ["COUNT(*) FILTER (WHERE final_price_conv <> 0) / NULLIF(COUNT(*), 0)", "Priced share", ".1%"], "ext_cost": ["SUM(ext_part_vol_price_conv)", "Extended volume cost (CBOM lines)", ",.0f"], "avg_lead_time": ["AVG(final_lead_time)", "Average lead time (weeks)", ",.1f"], "parts": ["COUNT(DISTINCT cpn)", "Distinct parts", ",d"], "suppliers": ["COUNT(DISTINCT supplier)", "Suppliers", ",d"]}
    },
    "cam_ex_inv": {"sql": "SELECT *, supp_name AS supplier FROM {ex_inv_vl_report}", "metrics": {"net_excess_cost": ["SUM(net_excess_cost)", "Net excess cost (lines)", ",.0f"], "final_buy_value": ["SUM(final_buy_value)", "Final buy value (lines)", ",.0f"], "lines": ["COUNT(*)", "Lines", ",d"]}},
    "cam_aclass": {"sql": "SELECT * FROM {aclass_parts_report}", "metrics": {"spend": ["SUM(ext_price_conv)", "Extended price", ",.2f"], "share": ["SUM(pct_of_total)", "Share of total", ".1%"]}},
    "cam_missing_notes": {"sql": "SELECT * FROM {missing_notes_report}", "metrics": {"lines": ["COUNT(*)", "Lines", ",d"], "mpn_mismatches": ["COUNT(*) FILTER (WHERE mpn_mismatch)", "MPN mismatches", ",d"], "commodity_mismatches": ["COUNT(*) FILTER (WHERE commodity_mismatch)", "Commodity mismatches", ",d"], "expiring_quotes": ["COUNT(*) FILTER (WHERE quote_expiring_soon)", "Quotes expiring soon", ",d"]}},
    "cam_feasibility": {"sql": "SELECT * FROM {feasibility_lines}", "metrics": {"lines": ["COUNT(*)", "Lines", ",d"], "cannot_build": ["COUNT(*) FILTER (WHERE verdict = 'Cannot build')", "Cannot build", ",d"], "avg_lead_time": ["AVG(lead_time_weeks)", "Average best lead time (weeks)", ",.1f"]}},
    "cam_feasibility_runs": {"sql": "SELECT * FROM {feasibility_risk_run}", "dttm": ["ran_at"], "metrics": {"lines": ["SUM(lines)", "Lines checked", ",d"], "cannot_build": ["SUM(cannot_build)", "Cannot build", ",d"]}},
    "cam_nre": {"sql": "SELECT rfq_id, 'PCB NRE & FAI' AS nre_type, cpn, description, commodity, mfg_name, nre_charge FROM {pcb_nre_fai_charge_report} UNION ALL SELECT rfq_id, 'Mech & EM NRE', cpn, description, commodity, mfg_name, nre_charge FROM {mech_em_nre_report}", "metrics": {"nre": ["SUM(nre_charge)", "NRE charge", ",.2f"]}},
    "cam_run_inputs": {"sql": "SELECT * FROM {run_inputs}", "metrics": {"inputs": ["COUNT(*)", "Inputs", ",d"]}},
    "summary_report": {"sql": "SELECT * FROM {summary_report}", "metrics": {}}
  },
  "charts": [
    {"page": 0, "row": 0, "width": 3, "name": "Cost per set (selected volume)", "dataset": "cam_kpi_volume", "viz": "big_number_total", "params": {"metric": "cost_per_set", "subheader": "from the workbook Summary tab", "y_axis_format": ",.2f"}},
    {"page": 0, "row": 0, "width": 3, "name": "Extended volume cost (selected volume)", "dataset": "cam_kpi_volume", "viz": "big_number_total", "params": {"metric": "ext_vol_cost", "subheader": "Ext Vol Conv Price", "y_axis_format": ",.0f"}},
    {"page": 0, "row": 0, "width": 3, "name": "Priced share of CBOM lines", "dataset": "cam_kpi_rfq", "viz": "gauge_chart", "params": {"metric": "priced_ratio", "groupby": [], "min_val": 0, "max_val": 1, "number_format": ".0%", "show_progress": true, "overlap": true}},
    {"page": 0, "row": 0, "width": 3, "name": "Uncosted parts", "dataset": "cam_kpi_rfq", "viz": "big_number_total", "params": {"metric": "uncosted_parts", "subheader": "Missing Notes, section 1", "y_axis_format": ",d"}},
    {"page": 0, "row": 1, "width": 6, "name": "Workbook figures by volume", "dataset": "cam_kpi_volume", "viz": "pivot_table_v2", "params": {"groupbyRows": ["metric"], "groupbyColumns": ["volume_no"], "metrics": ["value_sum"], "metricsLayout": "COLUMNS", "aggregateFunction": "Sum", "valueFormat": ",.2f", "rowOrder": "key_a_to_z", "colOrder": "key_a_to_z"}, "ignore_filters": ["Volume"]},
    {"page": 0, "row": 1, "width": 6, "name": "GO / NO-GO and workbook checks", "dataset": "cam_kpi_rfq", "viz": "table", "params": {"query_mode": "raw", "all_columns": ["rfq_id", "metric", "value", "text"], "row_limit": 500, "server_page_length": 10}},
    {"page": 0, "row": 2, "width": 12, "name": "Cost per set by assembly and volume", "dataset": "cam_cost_by_fg", "viz": "echarts_timeseries_bar", "params": {"x_axis": "fg", "groupby": ["volume_no"], "metrics": ["cost_per_set"], "y_axis_format": ",.2f", "show_value": true}, "ignore_filters": ["Volume"]},

    {"page": 1, "row": 0, "width": 4, "name": "Who set the price", "dataset": "cam_price_control", "viz": "pie", "params": {"groupby": ["price_control"], "metric": "ext_vol_cost", "donut": true, "show_labels": true, "label_type": "key_percent", "number_format": ",.0f"}},
