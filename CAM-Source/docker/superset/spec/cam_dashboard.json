    {"page": 2, "row": 1, "width": 6, "name": "Lead time spread by commodity", "dataset": "cam_cbom", "viz": "box_plot", "params": {"columns": ["cpn"], "groupby": ["commodity"], "metrics": ["avg_lead_time"], "whiskerOptions": "Tukey", "number_format": ",.1f"}},
    {"page": 2, "row": 1, "width": 6, "name": "Feasibility: lines by risk", "dataset": "cam_feasibility", "viz": "funnel", "params": {"groupby": ["risk"], "metric": "lines", "sort_by_metric": true, "percent_calculation_type": "first_step", "show_labels": true, "number_format": ",d"}},
    {"page": 2, "row": 2, "width": 6, "name": "Risk by commodity", "dataset": "cam_feasibility", "viz": "heatmap_v2", "params": {"x_axis": "commodity", "groupby": "risk", "metric": "lines", "sort_x_axis": "alpha_asc", "sort_y_axis": "alpha_asc", "normalize_across": "heatmap", "linear_color_scheme": "superset_seq_1", "show_values": true, "y_axis_format": ",d"}},
    {"page": 2, "row": 2, "width": 6, "name": "Commodity to build verdict", "dataset": "cam_feasibility", "viz": "sankey_v2", "params": {"source": "commodity", "target": "verdict", "metric": "lines"}},
    {"page": 2, "row": 3, "width": 12, "name": "Lines that cannot be built", "dataset": "cam_feasibility", "viz": "table", "params": {"query_mode": "raw", "all_columns": ["rfq_id", "fg", "part_number", "mpn", "commodity", "part_status", "lead_time_weeks", "risk", "reasons"], "adhoc_filters": [{"clause": "WHERE", "expressionType": "SIMPLE", "subject": "verdict", "operator": "==", "comparator": "Cannot build"}], "row_limit": 1000, "server_page_length": 10}},

    {"page": 3, "row": 0, "width": 4, "name": "Final buy value (selected volume)", "dataset": "cam_kpi_volume", "viz": "big_number_total", "params": {"metric": "final_buy_value", "subheader": "Batchwise Cashflow, Grand Total", "y_axis_format": ",.0f"}},
    {"page": 3, "row": 0, "width": 4, "name": "MOQ cost (selected volume)", "dataset": "cam_kpi_volume", "viz": "big_number_total", "params": {"metric": "moq_cost", "subheader": "Summary, MOQ Cost", "y_axis_format": ",.0f"}},
    {"page": 3, "row": 0, "width": 4, "name": "Excess cost (selected volume)", "dataset": "cam_kpi_volume", "viz": "big_number_total", "params": {"metric": "excess_cost", "subheader": "Ex Inv tab, Excess Cost", "y_axis_format": ",.0f"}},
    {"page": 3, "row": 1, "width": 6, "name": "Final buy by payment term and volume", "dataset": "cam_cashflow", "viz": "echarts_timeseries_bar", "params": {"x_axis": "supplier_type", "groupby": ["volume_no"], "metrics": ["final_buy_value"], "stack": "Stack", "y_axis_format": ",.0f"}, "ignore_filters": ["Volume"]},
