# ---- the ISATVON bounded do / check / hand-off loop -----------------------------------------------

def hand_off(state: dict[str, Any], status: str, reason: str, iterations: int) -> Outcome:
    fields = {k: state[k] for k in OUTCOME_FIELDS if k in state}
    return Outcome(status=status, reason=reason, iterations=iterations,
                   awaiting_human=state.get("awaiting_human", []), **fields)


def run_loop(payload: dict[str, Any]) -> Outcome:
    started = time.monotonic()
    state: dict[str, Any] = dict(payload)
    state["awaiting_human"] = [s["step_id"] for s in STEPS if s["mode"] == "Human"]
    if is_no_op(state):
        return hand_off(state, "no_op", "no_op_condition", 0)
    iterations = 0
    while iterations < MAX_ITERATIONS:
        iterations += 1
        for step in STEPS:
            if step["mode"] == "Human":
                continue  # a person does this step; it is listed in awaiting_human
            if (time.monotonic() - started) * 1000 > BUDGET_MS:
                return hand_off(state, "escalated", "budget_exceeded", iterations)
            state = do_step(step, state)
            if should_escalate(state):
                return hand_off(state, "escalated", "escalation_condition", iterations)
        if check(state):
            return hand_off(state, "done", "success_gate", iterations)
    return hand_off(state, "escalated", "max_iterations", iterations)


