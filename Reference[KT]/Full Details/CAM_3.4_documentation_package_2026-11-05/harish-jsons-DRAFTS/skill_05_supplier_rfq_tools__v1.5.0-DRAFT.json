  "isatvon_definition": {
    "i_instructions": "Triggered by Skill 4 hook[cite: 7]. Action: Prepare sub-tier RFQs, dispatch to vendors via email/SupplyWin(Secure) portal, and ingest returned supplier quotes in real time[cite: 1, 7]. Check: Verify all sent line-item RFQs maintain active response or timeout status[cite: 6, 7].",
    "s_source": {
      "required_inputs": [
        "assigned_supplier_matrix",
        "scrub_bom_table",
        "supplier_master_contacts"
      ],
      "fresh_state_parameters": ["raw_vendor_quotes_table", "quote_response_tracker"]
    },
    "a_automation": {
      "orchestration_layer": "Temporal Workflow (SRI Runtime)",
      "action_step": "Dispatch vendor RFQ packages, poll inbox/webhooks, and parse returned bid sheets into database tables[cite: 7].",
      "acceptance_check": "Programmatically evaluate: quotes_received_count >= 1 PER line_item OR timeout_flagged == True[cite: 6, 7]."
    },
    "t_tech_stack": {
      "execution_layer": "FastMCP Engine",
      "action_tool": "Supplier_RFQ_Dispatcher_Parser_MCP",
      "fixed_check_tool": "RFQ_Response_Tracker_Validator",
      "gateway": "Bifrost Gateway",
      "telemetry_observer": "PostHog Audit Logger"
    },
    "v_variables": {
      "max_iterations": 5,
      "success_gate": "vendor_quotes_ingested == True",
      "no_op_condition": "all_quotes_already_received == True",
      "escalation_condition": "vendor_quote_deadline_exceeded",
      "budget_limit": "86400000ms"
    },
    "o_outcome": {
      "json_schema": "RawSupplierQuotesPayload",
      "state_handoff_file": "Append to PostgreSQL 'rfq_vendor_quotes_audit_log'[cite: 6, 7]."
    },
    "n_next": {
      "ui_updates": ["Status: RFQs Dispatched -> Ingesting Supplier Bids"],
      "database_updates": ["Insert into vendor_quote_line_items"],
      "alerts": ["PostHog logs vendor response rates; alert buyer when quote returned[cite: 1, 7]"],
      "next_step": "On human Action button press, fire completion hook to Skill 6 (SAP/API Cost Extraction)[cite: 7]."
    }
  },
