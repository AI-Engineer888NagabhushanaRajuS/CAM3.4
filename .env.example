# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# Used by docker-compose.yml (required -- compose refuses to start without it)
POSTGRES_PASSWORD=change-me

# Used by docker-compose.yml and the Python services (required)
JWT_SECRET=change-me

# Used by setup_postgres.ps1 (native PostgreSQL bootstrap, required there)
CAM_PG_SUPERUSER_PASSWORD=change-me
CAM_PG_APP_USER=solutions@digibull.ai
CAM_PG_APP_PASSWORD=change-me

# Used by the Python services; URL-encode special characters in passwords
LOGIC_DB_URL=postgresql://solutions%40digibull.ai:change-me@localhost:5432/logic_db_2
FILE_METADATA_DB_URL=postgresql://solutions%40digibull.ai:change-me@localhost:5432/file_metadata_db_2

# Distributor pricing (mcp-tools/distributor-pricing). Keys are read from the environment only.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
ELEMENT14_API_KEY=
ELEMENT14_STORE=www.newark.com
MYSQL_PASSWORD=

# Bind address for the tool servers inside containers (0.0.0.0 = all interfaces).
CAM_BIND_HOST=0.0.0.0
REPORTING_INPUT_DB=/app/database/input_db.duckdb

# intake, distributor-pricing and gerber-integration share this DuckDB (3.3: bom_storage.duckdb).
BOM_STORAGE_DB=/app/database/bom_storage.duckdb

# Malware scanner run by intake's scan_local_file. Unset = the 3.3 Windows path
# (C:\Program Files\ClamAV\clamscan.exe). The compose image installs ClamAV, so it sets "clamscan".
# CLAMSCAN_PATH=clamscan
